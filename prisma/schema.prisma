generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id          Int      @id @default(autoincrement())
  userId      String   @default("default-player")
  title       String
  platform    String
  status      String   @default("Backlog")
  wasFlatlined Boolean @default(false)
  pinnedOrder Int?
  lengthHours Int      @default(10)
  hoursPlayed Int      @default(0)
  notes       String?
  rating      Int?
  difficulty  Int      @default(1)
  earnedXp    Int      @default(0)
  createdAt   DateTime @default(now())
  coverUrl    String?
  genre       String?
  releaseYear Int?

  @@index([userId])
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  userId         String   @default("default-player")
  achievementKey String
  xpAwarded      Int
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
}
