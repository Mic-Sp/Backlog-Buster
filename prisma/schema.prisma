generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Allow the operator bootstrap command to load the client with native Node TS support.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ProfileVisibility {
  public
  friends
  private
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum ActivityEventType {
  game_started
  game_completed
  game_flatlined
  rating_logged
  achievement_unlocked
  library_imported
}

model Player {
  id                String            @id @default(cuid())
  email             String?           @unique
  passwordHash      String?
  isAdmin           Boolean           @default(false)
  // Singleton and immutable-owner constraints live in owner-constraints.sql.
  isOwner           Boolean           @default(false)
  handle            String?           @unique
  // Shared audience for the dossier and future activity; private is owner-only.
  profileVisibility ProfileVisibility @default(public)
  // Public profile identifier only; this is not proof of Steam account ownership.
  steamId           String?
  steamLastSyncedAt  DateTime?
  // Claim attempts too, so private/unreachable profiles do not retry every visit.
  steamAutoSyncAttemptedAt DateTime?
  operatorName      String            @default("ANONYMOUS NETRUNNER")
  tagline           String            @default("One more gig. One more legend.")
  neonAccent        String            @default("CYAN")
  preferredLayoutMode String          @default("cyberpunk")
  avatarUrl         String?
  featuredTrophyIds Json              @default("[]")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  games             Game[]
  userAchievements  UserAchievement[]
  sessions          PlayerSession[]
  friendshipsLow    Friendship[]      @relation("FriendshipLow")
  friendshipsHigh   Friendship[]      @relation("FriendshipHigh")
  activityEvents    ActivityEvent[]
}

// Append-only apart from deletion of source data/account resets. Apply
// activity-event-constraints.sql after db push for immutable rows and source checks.
model ActivityEvent {
  id               String            @id @default(cuid())
  actorId          String
  actor            Player            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  type             ActivityEventType
  metadata         Json
  createdAt        DateTime          @default(now())
  deduplicationKey String
  gameId           Int?
  game             Game?             @relation(fields: [gameId], references: [id], onDelete: Cascade)
  achievementId    Int?
  achievement      UserAchievement?  @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([actorId, deduplicationKey])
  @@index([actorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([gameId])
  @@index([achievementId])
}

// IDs are sorted before writes. Apply friendship-constraints.sql after db push
// to enforce canonical ordering and valid states at the database boundary too.
model Friendship {
  playerLowId   String
  playerHighId  String
  playerLow     Player           @relation("FriendshipLow", fields: [playerLowId], references: [id], onDelete: Cascade)
  playerHigh    Player           @relation("FriendshipHigh", fields: [playerHighId], references: [id], onDelete: Cascade)
  status        FriendshipStatus @default(pending)
  // Must be one of the pair for pending/accepted, and null for blocks.
  requestedById String?
  // Independent ownership allows reciprocal blocks without duplicate pair rows.
  blockedByLow  Boolean          @default(false)
  blockedByHigh Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@id([playerLowId, playerHighId])
  @@index([playerHighId, status])
  @@index([playerLowId, status])
}

model PlayerSession {
  tokenHash String   @id
  userId    String
  player    Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Permanent one-time bootstrap latch; intentionally survives player deletion.
model AdminBootstrap {
  id          String   @id
  completedAt DateTime @default(now())
}

// Server-only application key, generated once when no AUTH_SECRET is supplied.
model AuthSecret {
  id    String @id
  value String
}

model AuthRateLimit {
  key      String   @id
  attempts Int      @default(1)
  resetsAt DateTime

  @@index([resetsAt])
}

// Global public game metadata only; never store operator IDs or personal data here.
model FranchiseChronology {
  // Normalized lowercase franchise key, e.g. "resident-evil".
  slug        String   @id
  displayName String
  // Ordered entries: { title: string, releaseYear: number | null, chronologicalRank: number }[].
  games       Json     @default("[]")
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Server-to-server credentials only; never include this model in client/public payloads.
model ExternalOAuthToken {
  provider    String   @id
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Public, provider-verified metadata only; never populate from player-entered titles.
model GameCatalog {
  // Lowercase canonical title plus release year preserves remakes with the same name.
  key            String   @id
  title          String
  releaseYear    Int?
  platforms      String[] @default([])
  genre          String?
  estimatedHours Int?
  coverUrl       String?
  rawgId         Int?
  rawgSlug       String?
  genres         String[] @default([])
  tags           String[] @default([])
  // Curated prefix hints from the provider's canonical title, not confirmed franchise membership.
  seriesHints    String[] @default([])
  // Positive tag evidence only; missing evidence is null, never false.
  multiplayer    Boolean?
  coop           Boolean?
  onlineCoop     Boolean?
  localCoop      Boolean?
  metadataSource String?
  metadataUpdatedAt DateTime?
  // Managed atomically with metadata via catalog-store.ts; enable vector before db push.
  featureVector Unsupported("vector(128)")?
  featureVectorVersion String?
  featureContentHash String?
  featureVectorUpdatedAt DateTime?
  updatedAt      DateTime @updatedAt

  @@index([title])
  @@index([rawgId])
}

model Game {
  id          Int      @id @default(autoincrement())
  userId      String   @default("default-player")
  player      Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  platform    String
  status      String   @default("Backlog")
  // Advances only for status/rating changes, including silent returns to Backlog.
  activityRevision Int @default(0)
  wasFlatlined Boolean @default(false)
  pinnedOrder Int?
  backlogOrder Int?
  lengthHours Int      @default(10)
  hoursPlayed Int      @default(0)
  notes       String?
  rating      Int?
  difficulty  Int      @default(1)
  earnedXp    Int      @default(0)
  createdAt   DateTime @default(now())
  coverUrl    String?
  genre       String?
  franchise   String?
  chronologicalOrder Int?
  releaseYear Int?

  // Decimal AppID string avoids signed-Int limits; null for non-Steam copies.
  steamAppId  String?
  activityEvents ActivityEvent[]

  @@index([userId])
  @@unique([userId, steamAppId])
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  userId         String   @default("default-player")
  player         Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  xpAwarded      Int
  unlockedAt     DateTime @default(now())
  activityEvents ActivityEvent[]

  @@unique([userId, achievementKey])
}
