generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Allow the operator bootstrap command to load the client with native Node TS support.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                String            @id @default(cuid())
  email             String?           @unique
  passwordHash      String?
  isAdmin           Boolean           @default(false)
  handle            String?           @unique
  operatorName      String            @default("ANONYMOUS NETRUNNER")
  tagline           String            @default("One more gig. One more legend.")
  neonAccent        String            @default("CYAN")
  avatarUrl         String?
  featuredTrophyIds Json              @default("[]")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  games             Game[]
  userAchievements  UserAchievement[]
  sessions          PlayerSession[]
}

model PlayerSession {
  tokenHash String   @id
  userId    String
  player    Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Permanent one-time bootstrap latch; intentionally survives player deletion.
model AdminBootstrap {
  id          String   @id
  completedAt DateTime @default(now())
}

// Server-only application key, generated once when no AUTH_SECRET is supplied.
model AuthSecret {
  id    String @id
  value String
}

model AuthRateLimit {
  key      String   @id
  attempts Int      @default(1)
  resetsAt DateTime

  @@index([resetsAt])
}

// Global public game metadata only; never store operator IDs or personal data here.
model FranchiseChronology {
  // Normalized lowercase franchise key, e.g. "resident-evil".
  slug        String   @id
  displayName String
  // Ordered entries: { title: string, releaseYear: number | null, chronologicalRank: number }[].
  games       Json     @default("[]")
  source      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Server-to-server credentials only; never include this model in client/public payloads.
model ExternalOAuthToken {
  provider    String   @id
  accessToken String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Game {
  id          Int      @id @default(autoincrement())
  userId      String   @default("default-player")
  player      Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  platform    String
  status      String   @default("Backlog")
  wasFlatlined Boolean @default(false)
  pinnedOrder Int?
  backlogOrder Int?
  lengthHours Int      @default(10)
  hoursPlayed Int      @default(0)
  notes       String?
  rating      Int?
  difficulty  Int      @default(1)
  earnedXp    Int      @default(0)
  createdAt   DateTime @default(now())
  coverUrl    String?
  genre       String?
  franchise   String?
  chronologicalOrder Int?
  releaseYear Int?

  @@index([userId])
}

model UserAchievement {
  id             Int      @id @default(autoincrement())
  userId         String   @default("default-player")
  player         Player   @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementKey String
  xpAwarded      Int
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
}
