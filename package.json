{
  "name": "backlogbuster",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --test-concurrency=4 tests/*.test.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "catalog:seed": "node scripts/catalog-seed.cjs",
    "catalog:backfill": "node scripts/catalog-seed.cjs --vectors-only",
    "catalog:verify-vectors": "node scripts/verify-vector-recommendations.cjs",
    "test:auth": "node --test tests/auth.test.cjs",
    "test:validation": "node --test tests/validation.test.cjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.cjs",
    "auth:backfill-verification": "node scripts/backfill-email-verification.cjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/analytics": "^2.0.1",
    "jose": "^6.2.16",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
