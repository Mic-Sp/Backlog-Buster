DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require"
# Trusted public origin for auth links. Required HTTPS URL in production.
APP_URL="http://localhost:3000"
# Google OAuth Web Application credentials. Register both callback URLs:
# http://localhost:3000/api/auth/google/callback
# https://backlog-buster-chi.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional locally: without a key, auth links appear only in server output.
# Production requires a Resend key and a sender on a verified domain.
RESEND_API_KEY=""
EMAIL_FROM="Backlog Buster <security@example.com>"
# Optional beta feedback inbox. Reuses RESEND_API_KEY and EMAIL_FROM above.
# Without all three values (or if delivery fails), reports go to server logs.
FEEDBACK_EMAIL_TO=""
RAWG_API_KEY="your_rawg_api_key_here"
# Optional for Steam OpenID sign-in; used for persona/avatar enrichment and required for library sync.
STEAM_API_KEY="your_steam_web_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
TWITCH_CLIENT_ID="your_client_id_here"
TWITCH_CLIENT_SECRET="your_client_secret_here"

# Optional: existing authenticated Player.id for `npm run admin:bootstrap`.
# Used only by the explicit one-time command, never by login or authorization.
ADMIN_BOOTSTRAP_PLAYER_ID=""
# Optional immutable existing Player.id for the separate one-time Owner bootstrap.
OWNER_BOOTSTRAP_PLAYER_ID=""
